# Python cache and environment files
__pycache__/
*.pyc
venv/
env/

# Data and model files - Do not commit these to GitHub!
ml_dataset.json
*.pkl
corrections.json
*.keras
evaluation.py

# Local folders for beatmaps
downloads/

# Secrets file
.env

# IDE and OS-specific files
.idea/
.vscode/
.DS_Store
*.png

# MLOps local state. The tracking DB and its artifact store are a local
# scratchpad, not a deliverable - a committed mlruns/ would be both huge and
# meaningless on anyone else's machine.
mlruns/
mlflow.db
.prefect/

# Candidate models awaiting a promotion decision. Only promoted artifacts reach
# the repo root, and those are ignored by the *.keras / *.pkl rules above.
candidates/

# Feature extraction cache, keyed on dataset hash.
.cache/

# Generated reports.
drift_report.html
drift_reports/
*.onnx

# Throwaway tracking DBs used by the gate verification runs, so a demo never
# writes to the real registry. Glob, not a literal name: verification scripts
# create .tmp_mlflow2.db and friends, and one of those slipped past an exact
# match once already.
.tmp_mlflow*.db

# Build outputs regenerated by `cli.py export-onnx` from the current models.
# Committing one risks it drifting out of sync with the .onnx files beside it,
# which is a silent corruption rather than an error.
model_config.json

# Calibration and measurement outputs. Regenerable with tools/calibrate_gate.py,
# and the numbers that matter are transcribed into VERIFIED.md - a committed copy
# would just be a second version to drift out of date.
seed_calibration.json
gate_calibration.json
metric_stability.json
excluded_tag_guard.json
weak_gate_scores.json
